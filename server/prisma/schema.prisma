generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                       @id @default(autoincrement())
  email         String                    @unique
  passwordHash  String  
  name          String?
  createdAt     DateTime @default(now())
}

model Artwork {
  id            Int                       @id @default(autoincrement())
  name          String                    
  artist        String  
  description   String?
  medium        String?
  price         Float
  imageUrl      String?
}
